<Window x:Class="Assignment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
			<Label Content="Git Basic" HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,20"/>

			<Button x:Name="btnHello" Content="Show Message" Width="120" Height="30" Click="btnHello_Click"/>
            <Button x:Name="btnBye" Content="Bye Button" Width="120" Height="30" Click="btnBye_Click"/>

        </StackPanel>
	</Grid>
</Window>
